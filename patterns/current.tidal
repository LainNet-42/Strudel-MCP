// 两只老虎 - 合成器版
setDefaultVoicings('legacy')

const chrds = "C@4 C@2 G@2 C@4 C@2 G@2 C@2".slow(8);

stack(
"C4 D4 E4 C4 C4 D4 E4 C4 E4 F4 G4@2 E4 F4 G4@2 [G4 A4 G4 F4] E4 C4 [G4 A4 G4 F4] E4 C4 C4 G3 C4@2 C4 G3 C4@2".slow(8).note().s("sawtooth").cutoff(1500).gain(0.5).attack(0.01).decay(0.15).sustain(0.4).release(0.1).color('green'),

chord(chrds).anchor("G4").struct("x*2").voicing().s("triangle").lpf(800).gain(0.3).color('yellow'),

n("0 ~ 4 ~").chord(chrds).anchor(chrds.rootNotes(2)).voicing().s("triangle").lpf(300).gain(0.7).color('blue'),

s("bd ~ ~ ~, ~ ~ hh ~").bank("RolandTR808").gain(0.3)

).cpm(100/4).room(0.3)
